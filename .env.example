# ============================================================
# OmniGuard Analyzer (Python) - Variables de Entorno de Ejemplo
# ============================================================

# Webhook para notificaciones en canal Blue Team de Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Token M2M para autenticación ante Core Java (/api/v1/internal/**)
INTERNAL_API_TOKEN=replace-with-a-locally-generated-token

# URL base de la Core API Java
CORE_API_URL=http://localhost:8080/api/v1

# Escaneo activo (requiere iniciar el perfil active-scan en Docker Compose)
SCAN_CORE_API_URL=http://host.docker.internal:8080/api/v1
SCAN_COMMANDS_CHANNEL=scan_commands_channel
# Required for Docker: exact IPv4 address(es) of the authorized host, comma-separated.
SCAN_ALLOWED_TARGETS=
SCAN_TIMEOUT_SECONDS=0.5
SCAN_CONCURRENCY=32
SCAN_MAX_PORTS=1024

# Conexión a Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CHANNEL=network_events

# Conexión a PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=omniguard
POSTGRES_USER=omniguard
POSTGRES_PASSWORD=omniguard_dev_edwarda2
